# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=ai_coding_mentor

# JWT & Security
JWT_SECRET=your_secure_jwt_secret_key_min_32_chars

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# AI Service
AI_MODE=mock                          # mock or live
LLM_MODEL=gpt-4o-mini                 # gpt-4o-mini, gpt-4o, gpt-3.5-turbo
LLM_ERROR_SIMULATION=false            # Enable to test error handling
LLM_CONTEXT_TTL=1800000               # Conversation context TTL (ms, default 30min)
LLM_CACHE_ENABLED=false               # Enable response caching
LLM_CACHE_TTL=3600                    # Cache duration (seconds)

# Port
PORT=5000
